@page
@model WebApplication1.Areas.Identity.Pages.Checkout.Checkout_IndexModel

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="card-body p-4">
                    <h2 class="card-title mb-4 text-center">Завършване на поръчката</h2>

                    <form method="post" class="row g-3" id="checkoutForm">
                        <div class="col-md-6">
                            <label asp-for="Order.CustomerName" class="form-label">Име</label>
                            <input asp-for="Order.CustomerName" class="form-control form-control-lg" placeholder="Вашето име" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Order.Phone" class="form-label">Телефон</label>
                            <input asp-for="Order.Phone" class="form-control form-control-lg" placeholder="+359 88 123 4567" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Order.Address" class="form-label">Адрес</label>
                            <input asp-for="Order.Address" class="form-control form-control-lg" placeholder="Улица, номер, град" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Order.Email" class="form-label">Имейл</label>
                            <input asp-for="Order.Email" class="form-control form-control-lg" placeholder="you@example.com" />
                        </div>

                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-success btn-lg w-100">
                                <i class="bi bi-check-circle"></i> Завърши поръчката
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}