@page
@model ProductsIndexModel


<div class="row">
    <div class="col-md-3 mb-3">
        <h5>Категории</h5>
        <ul class="list-group">
            <li class="list-group-item"><a asp-page="./Index">Всички</a></li>
            @foreach (var c in Model.Categories)
            {
                <li class="list-group-item">
                    <a asp-page="./Index" asp-route-CategoryId="@c.Id">@c.Name</a>
                </li>
            }
        </ul>
    </div>

    <div class="col-md-9">
        <div class="row g-3">

            @foreach (var p in Model.Products)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card position-relative">

                        <div class="card-content">
                            <div class="top-bar">
                                <span>@p.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))</span>
                                <span class="float-right lnr lnr-heart"></span>
                            </div>

                            <div class="img">
                                <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid">
                            </div>
                        </div>

                        <div class="card-description">
                            <div class="title">@p.Name</div>
                        </div>

                        <div class="card-footer d-flex flex-wrap gap-1">
                            @if (p.Category != null)
                            {
                                <a asp-page="./Index" asp-route-CategoryId="@p.Category.Id" class="text-decoration-none">
                                    <div class="span">@p.Category.Name</div>
                                </a>
                            }
                        </div>

                        <div class="hover-buttons d-flex flex-column gap-2">
                            <a class="btn btn-outline-primary btn-sm"
                               asp-page="./Details" asp-route-id="@p.Id">
                                <i class="bi bi-eye"></i> Виж
                            </a>

                            <button class="btn btn-success btn-sm"
                                    onclick="addToCart(@p.Id)">
                                <i class="bi bi-cart-plus"></i> Добави
                            </button>
                        </div>

                    </div>
                </div>

            }

        </div>


        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Math.Ceiling(Model.Total / (double)Model.PageSize); i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-Page="@i" asp-route-CategoryId="@Model.CategoryId">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
